# Football AI Vision Analytics Configuration
# Copy this file to .env and update values as needed
# These settings override defaults in config.py

# Input/Output files
VIDEO_PATH=football_video.mp4
# best_jugadores_v2.pt (Tier 3, YOLOv11m) es el candidato validado para cámara
# lateral/baja — descárgalo del dataset de Kaggle y colócalo en la raíz del
# repo. best_100e.pt sigue como fallback mientras se valida con footage real
# de Dinamó. Ver docs/PLAN_player_tracking.md, sección T3.
MODEL_PATH=best_100e.pt
OUTPUT_DIR=output_videos
DEMO_DIR=futbol-ai-dashboard/public

# YOLO Detection Parameters
YOLO_CONF=0.10
YOLO_IOU=0.5
YOLO_IMGSZ=1280
YOLO_DEVICE=cpu
YOLO_TRACKER=bytetrack.yaml

# Processing Parameters
FRAME_WINDOW=5
MAX_SPEED_KMH=45
MIN_TRACK_DURATION=0.5
MAX_SPEED_GAP_FRAMES=30

# Field Calibration
FIELD_WIDTH_METERS=68

# Visualization
DISTANCE_THRESHOLD_PIXELS=60

# BoT-SORT + ReID tracker (Tier 1) — override Trackers/botsort.yaml at runtime
# BOTSORT_TRACK_HIGH_THRESH=0.5
# BOTSORT_TRACK_LOW_THRESH=0.1
# BOTSORT_NEW_TRACK_THRESH=0.6
# BOTSORT_TRACK_BUFFER=200
# BOTSORT_MATCH_THRESH=0.75
# BOTSORT_PROXIMITY_THRESH=0.5
# BOTSORT_APPEARANCE_THRESH=0.25
# BOTSORT_WITH_REID=true
# BOTSORT_GMC_METHOD=sparseOptFlow
# BOTSORT_REID_MODEL=auto

# Debugging
DEBUG_MODE=false

# MatchAnalytics v2 — derived-metric thresholds (all optional, these are the defaults)
SPRINT_THRESHOLD_KMH=21.0
HI_THRESHOLD_KMH=15.0
HIGH_ACCEL_THRESHOLD_MS2=3.0
PEAK_WINDOW_SEC=300
ANALYTICS_GRID_ROWS=10
ANALYTICS_GRID_COLS=10
SPEED_ZONE_WALK_KMH=7.0
SPEED_ZONE_JOG_KMH=15.0
SPEED_ZONE_RUN_KMH=21.0
